# ==============================================================================
# Siddarth AI Browser Assistant - Environment Variables (Local Testing Only)
# ==============================================================================
# NOTE: Chrome Extension runs inside the browser client-side.
# For everyday browser usage, enter your API key directly in the Side Panel:
# Open Side Panel -> Settings Tab -> Gemini API Key -> Click "Save All Settings"
#
# This .env file is optional and used for local CLI verification scripts (Node.js).
# Get your free Gemini API key: https://aistudio.google.com/apikey
# ==============================================================================

# Google Gemini API Key (starts with AIzaSy...)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq Cloud API Key for fallback (starts with gsk_...)
# Get your free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

